# Kaboo — environment variable NAMES only. Never commit values.
#
# All of these are OPTIONAL. With none of them set, Kaboo runs entirely on the
# in-memory StateStore and Realtime adapters: a single Node process, no external
# services, perfect for local development. Set them to run across serverless
# instances on Vercel.

# --- Room state (Upstash Redis via the Vercel Marketplace) -------------------
# Required together: if either is missing, the in-memory store is used.
# Vercel's Upstash integration injects <PREFIX>_KV_REST_API_URL and
# <PREFIX>_KV_REST_API_TOKEN instead (e.g. STORAGEKOBUL_KV_REST_API_URL). Those are
# found automatically (src/store/env.ts), so on Vercel you do not need to set
# these two by hand. Never use the READ_ONLY token: the store writes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Realtime fan-out (Ably) -------------------------------------------------
# Required for cross-instance push. Without it, clients fall back to polling
# the room state endpoint, which works but is slower.
ABLY_API_KEY=

# --- Session tokens ----------------------------------------------------------
# HMAC key used to sign per-player session tokens and Ably channel tokens.
# Generate with: openssl rand -hex 32
# Optional when Upstash Redis is configured: the key is then derived from the Redis
# token, so every serverless instance agrees without anything set here.
ROOM_SECRET=
